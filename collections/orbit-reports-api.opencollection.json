{
  "opencollection": "1.0.0",
  "info": {
    "name": "Orbit Activities Reports API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a workspace stats",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://web.archive.org/web/20240303060821/https://app.orbit.love/api/v1/:workspace_slug/reports",
            "params": [
              {
                "name": "workspace_slug",
                "value": "",
                "type": "path"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Filter activities after this date. Format: YYYY-MM-DD."
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "Filter activities before this date. Format: YYYY-MM-DD."
              },
              {
                "name": "relative",
                "value": "",
                "type": "query",
                "description": "Relative timeframes. Format: this_<integer>_<period>, with period in [days, weeks, months, years]. For example, this_30_days."
              },
              {
                "name": "properties",
                "value": "",
                "type": "query"
              },
              {
                "name": "activity_type",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Deprecated in favor of the activity_type parameter."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a workspace stats"
        }
      ]
    }
  ],
  "bundled": true
}